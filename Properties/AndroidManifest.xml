<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="29" />

  <!-- Wi-Fi Aware discovery is location-sensitive on Android: without
       ACCESS_FINE_LOCATION *and* location services switched on, attach()
       succeeds but no service is ever discovered, with no error. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
  <uses-permission android:name="android.permission.INTERNET" />

  <uses-feature android:name="android.hardware.wifi.aware" android:required="true" />

  <application android:label="NanTest" android:usesCleartextTraffic="true" />
</manifest>
