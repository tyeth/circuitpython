#
# CP-WIFI-DEBUG (release-optimised variant): keep the opt build's RAM/flash profile but
# route ESP_LOGW/ESP_LOGE + DHCPS_DEBUG printf to the UART0 console (devkit UART bridge).
# Use with: make BOARD=... EXTRA_SDKCONFIG=esp-idf-config/sdkconfig-wifidebug-opt.defaults
#
# CONFIG_ESP_CONSOLE_NONE is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Fault forensics: the opt profile sets PANIC_SILENT_REBOOT, so a hard fault
# reboots with no output at all. Print the Guru Meditation register dump and
# backtrace, then halt, so the failing state is preserved instead of being
# overwritten by a reboot. A halted board stays dead until it is reset --
# intentional on the bench, where we would rather keep the evidence.
# This is also what surfaces "Brownout detector was triggered"
# (CONFIG_ESP_BROWNOUT_USE_INTR=y), which tells a sagging supply apart from a
# genuine firmware fault.
# CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT is not set
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
# CONFIG_LOG_DEFAULT_LEVEL_NONE is not set
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_WARN=y
# TLS server: a 3.7KB Let's Encrypt chain must fit one outgoing handshake record
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
